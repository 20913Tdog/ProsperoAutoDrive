diff --git a/include/smb2/libsmb2.h b/include/smb2/libsmb2.h
index 21b5286..216d8c5 100644
--- a/include/smb2/libsmb2.h
+++ b/include/smb2/libsmb2.h
@@ -1646,6 +1646,14 @@ struct smb2_server {
          * instead of having to sleep and hope.
          */
         volatile int listener_ready;
+        /*
+         * Upper limit for the credits a client may hold, i.e. for the
+         * work it may have outstanding (one credit per 64 KiB of a READ
+         * or WRITE). 0 grants whatever the client asks for. A low limit
+         * keeps a big transfer from queueing seconds of data ahead of a
+         * small request on the same connection.
+         */
+        uint16_t credit_limit;
 };
 
 int smb2_bind_and_listen(const uint16_t port, const int max_connections, int *out_fd);
diff --git a/lib/pdu.c b/lib/pdu.c
index 059630d..a01a364 100644
--- a/lib/pdu.c
+++ b/lib/pdu.c
@@ -666,6 +666,43 @@ smb2_correlate_reply(struct smb2_context *smb2, struct smb2_pdu *pdu)
                         pdu->header.credit_charge = req_pdu->header.credit_charge;
                 }
 
+                /* Optional credit limit: grant no more than keeps the
+                 * client's credits plus the charge of its requests in
+                 * flight at credit_limit, but always enough that it is
+                 * not left with none, and at least one when the client
+                 * asked for credits (MS-SMB2 3.3.1.2). Above the limit
+                 * the client's credits then go down by the charge minus
+                 * one per reply. (Granting none there, a Windows client
+                 * reset the connection twice after the limit dropped.)
+                 */
+                {
+                        struct smb2_server *srv = smb2->owning_server;
+                        int64_t charge = req_pdu->header.credit_charge ?
+                                req_pdu->header.credit_charge : 1;
+                        int64_t held = 1 + smb2->srv_credits_net - charge;
+
+                        if (srv && srv->credit_limit) {
+                                int64_t room = (int64_t)srv->credit_limit - held;
+                                int64_t asked = pdu->header.credit_request_response;
+                                int64_t grant = asked;
+
+                                if (grant > room) {
+                                        grant = room;
+                                }
+                                if (held + grant < 1) {
+                                        grant = 1 - held;
+                                }
+                                if (grant < 1 && asked > 0) {
+                                        grant = 1;
+                                }
+                                if (grant < 0) {
+                                        grant = 0;
+                                }
+                                pdu->header.credit_request_response = (uint16_t)grant;
+                        }
+                        smb2->srv_credits_net += (int64_t)pdu->header.credit_request_response - charge;
+                }
+
